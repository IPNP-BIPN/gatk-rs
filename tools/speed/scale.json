 "steps_comment": "The best-practices chain on chr20. Each step reads the REFERENCE's output of the steps it needs (mounted at {in}/<step>), so both sides of every step get identical input, and a port failure upstream does not hide the steps below it. {threads} is the same on both sides: the JVM's pair-HMM and Spark threads, and the port's RAYON_NUM_THREADS. VCF writers hold --add-output-vcf-command-line false because ##GATKCommandLine carries the run's wall-clock time. `group` is the CI job a step runs in. `timeout` is seconds per side, chosen so a group's runs fit one 6-hour CI job; a side that reaches it is killed and recorded as such.",
 "steps": [
  {
   "name": "MarkDuplicatesSpark",
   "group": "prep",
   "needs": [],
   "args": "-I {data}/NA12878.chr20.bam -O {out}/md.bam -M {out}/md.metrics --spark-master local[{threads}] --tmp-dir /work/tmp",
   "timeout": 3000
  },
  {
   "name": "BaseRecalibrator",
   "group": "prep",
   "needs": [
    "MarkDuplicatesSpark"
   ],
   "args": "-R {data}/chr20.fasta -I {in}/MarkDuplicatesSpark/md.bam --known-sites {data}/dbsnp138.chr20.vcf.gz --known-sites {data}/mills.chr20.vcf.gz --known-sites {data}/known_indels.chr20.vcf.gz -O {out}/recal.table",
   "timeout": 3000
  },
  {
   "name": "ApplyBQSR",
   "group": "prep",
   "needs": [
    "MarkDuplicatesSpark",
    "BaseRecalibrator"
   ],
   "args": "-R {data}/chr20.fasta -I {in}/MarkDuplicatesSpark/md.bam --bqsr-recal-file {in}/BaseRecalibrator/recal.table -O {out}/bqsr.bam",
   "timeout": 3000
  },
  {
   "name": "HaplotypeCaller",
   "group": "haplotypecaller",
   "needs": [
    "ApplyBQSR"
   ],
   "args": "-R {data}/chr20.fasta -I {in}/ApplyBQSR/bqsr.bam -L chr20 -ERC GVCF --native-pair-hmm-threads {threads} -O {out}/g.vcf.gz --add-output-vcf-command-line false",
   "timeout": 9900
  },
  {
   "name": "GenotypeGVCFs",
   "group": "joint",
   "needs": [
    "HaplotypeCaller"
   ],
   "args": "-R {data}/chr20.fasta -V {in}/HaplotypeCaller/g.vcf.gz -O {out}/geno.vcf.gz --add-output-vcf-command-line false",
   "timeout": 1800
  },
  {
   "name": "VariantRecalibrator",
   "group": "joint",
   "needs": [
    "GenotypeGVCFs"
   ],
   "args": "-R {data}/chr20.fasta -V {in}/GenotypeGVCFs/geno.vcf.gz -mode SNP --resource:hapmap,known=false,training=true,truth=true,prior=15.0 {data}/hapmap.chr20.vcf.gz --resource:omni,known=false,training=true,truth=false,prior=12.0 {data}/omni.chr20.vcf.gz --resource:1000G,known=false,training=true,truth=false,prior=10.0 {data}/phase1.chr20.vcf.gz --resource:dbsnp,known=true,training=false,truth=false,prior=2.0 {data}/dbsnp138.chr20.vcf.gz -an QD -an MQ -an MQRankSum -an ReadPosRankSum -an FS -an SOR --max-gaussians 6 -O {out}/snps.recal --tranches-file {out}/snps.tranches --add-output-vcf-command-line false",
   "timeout": 1800
  },
  {
   "name": "ApplyVQSR",
   "group": "joint",
   "needs": [
    "GenotypeGVCFs",
    "VariantRecalibrator"
   ],
   "args": "-R {data}/chr20.fasta -V {in}/GenotypeGVCFs/geno.vcf.gz --recal-file {in}/VariantRecalibrator/snps.recal --tranches-file {in}/VariantRecalibrator/snps.tranches -mode SNP --truth-sensitivity-filter-level 99.7 -O {out}/vqsr.vcf.gz --add-output-vcf-command-line false",
   "timeout": 1800
  },
  {
   "name": "SelectVariants",
   "group": "joint",
   "needs": [
    "ApplyVQSR"
   ],
   "args": "-V {in}/ApplyVQSR/vqsr.vcf.gz --select-type-to-include SNP --exclude-filtered -O {out}/select.vcf.gz --add-output-vcf-command-line false",
   "timeout": 1800
  },
  {
   "name": "VariantFiltration",
   "group": "joint",
   "needs": [
    "GenotypeGVCFs"
   ],
   "args": "-V {in}/GenotypeGVCFs/geno.vcf.gz --filter-expression 'QD < 2.0' --filter-name QD2 --filter-expression 'FS > 60.0' --filter-name FS60 --filter-expression 'MQ < 40.0' --filter-name MQ40 -O {out}/vf.vcf.gz --add-output-vcf-command-line false",
   "timeout": 1800
  },
  {
   "name": "Mutect2",
   "group": "mutect2",
   "needs": [
    "ApplyBQSR"
   ],
   "args": "-R {data}/chr20.fasta -I {in}/ApplyBQSR/bqsr.bam -L chr20 --germline-resource {data}/gnomad.chr20.vcf.gz --panel-of-normals {data}/pon.chr20.vcf.gz --native-pair-hmm-threads {threads} -O {out}/m2.vcf.gz --add-output-vcf-command-line false",
   "timeout": 9300
  },
  {
   "name": "FilterMutectCalls",
   "group": "mutect2",
   "needs": [
    "Mutect2"
   ],
   "args": "-R {data}/chr20.fasta -V {in}/Mutect2/m2.vcf.gz -O {out}/m2.filtered.vcf.gz --add-output-vcf-command-line false",
   "timeout": 900
  },
  {
   "name": "PreprocessIntervals",
   "group": "cnv",
   "needs": [],
   "args": "-R {data}/chr20.fasta -L chr20 --bin-length 1000 --padding 0 --interval-merging-rule OVERLAPPING_ONLY -O {out}/chr20.interval_list",
   "timeout": 1800
  },
  {
   "name": "CollectReadCounts",
   "group": "cnv",
   "needs": [
    "ApplyBQSR",
    "PreprocessIntervals"
   ],
   "args": "-I {in}/ApplyBQSR/bqsr.bam -L {in}/PreprocessIntervals/chr20.interval_list --interval-merging-rule OVERLAPPING_ONLY --format TSV -O {out}/counts.tsv",
   "timeout": 1800
  },
  {
   "name": "DenoiseReadCounts",
   "group": "cnv",
   "needs": [
    "CollectReadCounts"
   ],
   "args": "-I {in}/CollectReadCounts/counts.tsv --standardized-copy-ratios {out}/standardized.tsv --denoised-copy-ratios {out}/denoised.tsv",
   "timeout": 1800
  },
  {
   "name": "ModelSegments",
   "group": "cnv",
   "needs": [
    "DenoiseReadCounts"
   ],
   "args": "--denoised-copy-ratios {in}/DenoiseReadCounts/denoised.tsv -O {out} --output-prefix NA12878",
   "timeout": 1800
  }
 ]
}
